class_name GameMap
extends Node2D
## Map built from a JSON file in maps/. Handles walls, lanes, structures and
## grid pathfinding (AStarGrid2D); visuals are generated by MapArt (child node).
## "mirror": true copies the blue half (walls/towers/spawn/nexus/brush/camps) onto the red
## side left-right; "mirror": "rotate" copies it rotated by 180 degrees around the map centre
## (diagonal maps like Summoner's Rift - mirrored towers join the lane they end up on).
## Walls are rectangles [x, y, w, h] or polygons {"poly": [[x, y], ...]}; "brush" and "river"
## are polygons. Entries can opt out of mirroring with "mirror": false.

const CELL := 32.0
const MARGIN := Content.CHAMPION_PATH_RADIUS
const SIGHT_CELL := 16.0     # resolution of the sight grid (fog of war line of sight, brush lookup)
const SIGHT_WALL := 255

var data := {}
var size := Vector2(2400, 1600)
var walls: Array[Rect2] = []
var polys: Array[PackedVector2Array] = []       # polygon walls
var poly_boxes: Array[Rect2] = []
var brushes: Array[PackedVector2Array] = []
var rivers: Array[PackedVector2Array] = []
var camps: Array = []          # {id, kind, pos, path, side, first, respawn} - see Jungle
var shops: Array[Vector2] = []
var spawns: Array[Vector2] = [Vector2(200, 800), Vector2(2200, 800)]
var lanes: Array = []
var lane_order: Array = []     # lane per player slot of a team (-1 = jungle), cycled
var lane_names: Array = []
var lane_width := 75.0         # visual half width of the lane paths
var structures: Array = []
var dummies: Array = []
var wave_interval := 30.0
var first_wave := 65.0
var wave_melee := 3
var wave_ranged := 3
var rift_waves := false
var fountain_radius := 280.0
var ground := Color("2e4a2f")
var lane_color := Color("6e5f45")
var wall_color := Color("4a505c")
var astar := AStarGrid2D.new()
var cols := 1
var rows := 1
var mirror_mode := "x"         # "x" (left/right), "rotate" (180 degrees) or "" (none)
var sight := PackedByteArray() # SIGHT_CELL grid: 0 open, SIGHT_WALL wall, 1..254 brush id
var sight_cols := 1
var sight_rows := 1


func build(d: Dictionary) -> void:
	data = d
	size = _v(d.get("size"), size)
	var m = d.get("mirror", true)
	if m is String:
		mirror_mode = "rotate" if m in ["rotate", "point", "diagonal"] else ("" if m in ["", "none", "false"] else "x")
	else:
		mirror_mode = "x" if bool(m) else ""
	var mirror := mirror_mode != ""
	ground = Content.parse_color(d.get("ground_color"), ground)
	lane_color = Content.parse_color(d.get("lane_color"), lane_color)
	wall_color = Content.parse_color(d.get("wall_color"), wall_color)
	lane_width = float(d.get("lane_width", lane_width))
	for w in d.get("walls", []):
		var mirror_this := mirror and not (w is Dictionary and not bool(w.get("mirror", true)))
		var shape = w.get("poly", w.get("rect")) if w is Dictionary else w
		if shape is Array and shape.size() == 4 and not (shape[0] is Array):
			var r := Rect2(shape[0], shape[1], shape[2], shape[3]).abs()
			walls.append(r)
			if mirror_this:
				var mr := Rect2(mirror_point(r.position), Vector2.ZERO).expand(mirror_point(r.end))
				if not mr.is_equal_approx(r):
					walls.append(mr)
		else:
			for p in _polys(shape, mirror_this):
				polys.append(p)
				poly_boxes.append(_box(p))
	for b in d.get("brush", []):
		var mirror_this := mirror and not (b is Dictionary and not bool(b.get("mirror", true)))
		brushes.append_array(_polys(b.get("poly") if b is Dictionary else b, mirror_this))
	for r in d.get("river", []):
		var mirror_this := mirror and not (r is Dictionary and not bool(r.get("mirror", true)))
		rivers.append_array(_polys(r.get("poly") if r is Dictionary else r, mirror_this))
	spawns = _pair(d.get("spawn"), Vector2(220, size.y * 0.5), mirror)
	if d.has("shop"):
		shops = _pair(d.get("shop"), spawns[0], mirror)
	else:
		shops = spawns.duplicate()
	if d.has("nexus"):
		var nx := _pair(d.get("nexus"), Vector2(450, size.y * 0.5), mirror)
		for t in 2:
			structures.append({"kind": "nexus", "team": t, "lane": -1, "order": 99, "pos": nx[t]})
	for l in d.get("lanes", []):
		var pts := PackedVector2Array()
		if l is Array:
			for p in l:
				pts.append(_v(p, Vector2.ZERO))
		if pts.size() >= 2:
			lanes.append(pts)
	for k in d.get("lane_order", []):
		lane_order.append(int(k))
	lane_names = d.get("lane_names", []) if d.get("lane_names") is Array else []
	for t in d.get("towers", []):
		if not (t is Dictionary):
			continue
		var pos := _v(t.get("pos"), Vector2.ZERO)
		var team := int(t.get("team", 0))
		var info := {"kind": str(t.get("kind", "tower")), "team": team, "lane": int(t.get("lane", 0)),
			"order": int(t.get("order", 0)), "pos": pos}
		structures.append(info)
		if mirror and team == 0:
			var mt := info.duplicate()
			mt.team = 1
			mt.pos = mirror_point(pos)
			if mirror_mode == "rotate" and int(info.lane) >= 0:
				mt.lane = nearest_lane(mt.pos)
			structures.append(mt)
	for c in d.get("camps", []):
		if not (c is Dictionary):
			continue
		_add_camp(c, _v(c.get("pos"), size * 0.5), c.get("path"), false)
		if mirror and bool(c.get("mirror", true)):
			_add_camp(c, mirror_point(_v(c.get("pos"), size * 0.5)), c.get("path"), true)
	for p in d.get("dummies", []):
		dummies.append(_v(p, size * 0.5))
	var wv = d.get("waves", {})
	if wv is Dictionary:
		wave_interval = float(wv.get("interval", wave_interval))
		first_wave = float(wv.get("first", first_wave))
		wave_melee = int(wv.get("melee", wave_melee))
		wave_ranged = int(wv.get("ranged", wave_ranged))
		rift_waves = bool(wv.get("rift", false))
	fountain_radius = float(d.get("fountain_radius", fountain_radius))
	_build_bodies()
	_build_grid()
	_build_sight()
	var art := MapArt.new()
	add_child(art)
	art.build(self)


func _v(v, fallback: Vector2) -> Vector2:
	if v is Array and v.size() >= 2:
		return Vector2(float(v[0]), float(v[1]))
	return fallback


func _pair(v, fallback: Vector2, mirror: bool) -> Array[Vector2]:
	if v is Array and v.size() == 2 and v[0] is Array:
		return [_v(v[0], fallback), _v(v[1], fallback)]
	var a := _v(v, fallback)
	return [a, mirror_point(a) if mirror else a]


## Where the mirrored copy of a blue-half point goes.
func mirror_point(p: Vector2) -> Vector2:
	match mirror_mode:
		"rotate":
			return size - p
		"x":
			return Vector2(size.x - p.x, p.y)
	return p


## A polygon from [[x, y], ...] (at least 3 points), plus its mirrored copy.
func _polys(shape, mirror: bool) -> Array[PackedVector2Array]:
	var out: Array[PackedVector2Array] = []
	if not (shape is Array) or shape.size() < 3 or not (shape[0] is Array):
		return out
	var p := PackedVector2Array()
	for q in shape:
		p.append(_v(q, Vector2.ZERO))
	out.append(p)
	if mirror:
		var mp := PackedVector2Array()
		for q in p:
			mp.append(mirror_point(q))
		out.append(mp)
	return out


static func _box(p: PackedVector2Array) -> Rect2:
	var r := Rect2(p[0], Vector2.ZERO)
	for q in p:
		r = r.expand(q)
	return r


func _add_camp(c: Dictionary, pos: Vector2, path_v, mirrored: bool) -> void:
	var pth := PackedVector2Array()
	if path_v is Array:
		for q in path_v:
			var p := _v(q, pos)
			pth.append(mirror_point(p) if mirrored else p)
	var side := 0 if pos.distance_to(spawns[0]) <= pos.distance_to(spawns[1]) else 1
	camps.append({"id": camps.size(), "kind": str(c.get("kind", "")), "pos": pos, "path": pth, "side": side,
		"first": float(c.get("first", -1.0)), "respawn": float(c.get("respawn", -1.0))})


func lane_count() -> int:
	return lanes.size()


## The lane a team's n-th player plays ("lane_order"; -1 = jungle). Without one: n.
func role_lane(n: int) -> int:
	if lane_order.is_empty() or lanes.is_empty():
		return n
	return int(lane_order[posmod(n, lane_order.size())])


func lane_name(i: int) -> String:
	if i < 0:
		return "Jungle"
	return str(lane_names[i]) if i < lane_names.size() else "Lane %d" % (i + 1)


## Index of the lane passing closest to `p`.
func nearest_lane(p: Vector2) -> int:
	var best := 0
	var bd := INF
	for i in lanes.size():
		var l: PackedVector2Array = lanes[i]
		for k in range(1, l.size()):
			var d := p.distance_to(Geometry2D.get_closest_point_to_segment(p, l[k - 1], l[k]))
			if d < bd:
				bd = d
				best = i
	return best


func lane(team: int, i: int) -> PackedVector2Array:
	if i < 0 or i >= lanes.size():
		return PackedVector2Array()
	var l: PackedVector2Array = lanes[i].duplicate()
	if team == 1:
		l.reverse()
	return l


func spawn_point(team: int) -> Vector2:
	return spawns[clampi(team, 0, 1)]


# ------------------------------------------------------- collision & grid ---

func _build_bodies() -> void:
	var body := StaticBody2D.new()
	body.collision_layer = 1
	body.collision_mask = 0
	add_child(body)
	var th := 400.0
	var all := walls.duplicate()
	all.append(Rect2(-th, -th, size.x + 2 * th, th))
	all.append(Rect2(-th, size.y, size.x + 2 * th, th))
	all.append(Rect2(-th, 0, th, size.y))
	all.append(Rect2(size.x, 0, th, size.y))
	for r in all:
		var cs := CollisionShape2D.new()
		var sh := RectangleShape2D.new()
		sh.size = r.size
		cs.shape = sh
		cs.position = r.get_center()
		body.add_child(cs)
	for p in polys:
		var cp := CollisionPolygon2D.new()
		cp.polygon = p
		body.add_child(cp)


func _build_grid() -> void:
	cols = int(ceil(size.x / CELL))
	rows = int(ceil(size.y / CELL))
	astar.region = Rect2i(0, 0, cols, rows)
	astar.cell_size = Vector2(CELL, CELL)
	astar.offset = Vector2(CELL, CELL) * 0.5
	astar.diagonal_mode = AStarGrid2D.DIAGONAL_MODE_ONLY_IF_NO_OBSTACLES
	astar.default_compute_heuristic = AStarGrid2D.HEURISTIC_OCTILE
	astar.default_estimate_heuristic = AStarGrid2D.HEURISTIC_OCTILE
	astar.update()
	for r in walls:
		_fill(r.grow(MARGIN))
	for p in polys:
		# Cells touching the polygon grown by MARGIN = cell centres inside it grown by another half cell.
		for span in _scan(Geometry2D.offset_polygon(p, MARGIN + CELL * 0.5), CELL, cols, rows):
			astar.fill_solid_region(Rect2i(span.x, span.z, span.y - span.x + 1, 1), true)
	for s in structures:
		var rad: float = (62.0 if s.kind == "nexus" else 38.0) * 0.8
		_fill(Rect2(s.pos - Vector2(rad, rad), Vector2(rad, rad) * 2.0))
	for x in cols:
		astar.set_point_solid(Vector2i(x, 0), true)
		astar.set_point_solid(Vector2i(x, rows - 1), true)
	for y in rows:
		astar.set_point_solid(Vector2i(0, y), true)
		astar.set_point_solid(Vector2i(cols - 1, y), true)


## Sight grid: walls block line of sight, brush cells hold their brush id (fog of war).
func _build_sight() -> void:
	sight_cols = int(ceil(size.x / SIGHT_CELL))
	sight_rows = int(ceil(size.y / SIGHT_CELL))
	sight = PackedByteArray()
	sight.resize(sight_cols * sight_rows)
	for i in mini(brushes.size(), SIGHT_WALL - 1):
		for span in _scan([brushes[i]], SIGHT_CELL, sight_cols, sight_rows):
			var row: int = span.z * sight_cols
			for x in range(span.x, span.y + 1):
				sight[row + x] = i + 1
	for r in walls:
		var x0 := clampi(int(ceil(r.position.x / SIGHT_CELL - 0.5)), 0, sight_cols - 1)
		var x1 := clampi(int(floor(r.end.x / SIGHT_CELL - 0.5)), 0, sight_cols - 1)
		var y0 := clampi(int(ceil(r.position.y / SIGHT_CELL - 0.5)), 0, sight_rows - 1)
		var y1 := clampi(int(floor(r.end.y / SIGHT_CELL - 0.5)), 0, sight_rows - 1)
		for y in range(y0, y1 + 1):
			for x in range(x0, x1 + 1):
				sight[y * sight_cols + x] = SIGHT_WALL
	for p in polys:
		for span in _scan([p], SIGHT_CELL, sight_cols, sight_rows):
			var row: int = span.z * sight_cols
			for x in range(span.x, span.y + 1):
				sight[row + x] = SIGHT_WALL


## Rows of grid cells whose centres are inside `rings` (even-odd, so holes from offset_polygon
## work): Vector3i(first column, last column, row).
static func _scan(rings: Array, cell: float, ncols: int, nrows: int) -> Array[Vector3i]:
	var out: Array[Vector3i] = []
	if rings.is_empty():
		return out
	var box := Rect2(rings[0][0], Vector2.ZERO)
	for ring in rings:
		for q in ring:
			box = box.expand(q)
	var y0 := clampi(int(ceil(box.position.y / cell - 0.5)), 0, nrows - 1)
	var y1 := clampi(int(floor(box.end.y / cell - 0.5)), 0, nrows - 1)
	for y in range(y0, y1 + 1):
		var cy := (y + 0.5) * cell
		var xs := PackedFloat32Array()
		for ring: PackedVector2Array in rings:
			var n := ring.size()
			var a := ring[n - 1]
			for i in n:
				var b := ring[i]
				if (a.y <= cy) != (b.y <= cy):
					xs.append(a.x + (cy - a.y) / (b.y - a.y) * (b.x - a.x))
				a = b
		xs.sort()
		var k := 0
		while k + 1 < xs.size():
			var cx0 := maxi(int(ceil(xs[k] / cell - 0.5)), 0)
			var cx1 := mini(int(floor(xs[k + 1] / cell - 0.5)), ncols - 1)
			if cx1 >= cx0:
				out.append(Vector3i(cx0, cx1, y))
			k += 2
	return out


func _fill(g: Rect2) -> void:
	var x0 := clampi(int(floor(g.position.x / CELL)), 0, cols - 1)
	var x1 := clampi(int(floor(g.end.x / CELL)), 0, cols - 1)
	var y0 := clampi(int(floor(g.position.y / CELL)), 0, rows - 1)
	var y1 := clampi(int(floor(g.end.y / CELL)), 0, rows - 1)
	for x in range(x0, x1 + 1):
		for y in range(y0, y1 + 1):
			astar.set_point_solid(Vector2i(x, y), true)


func cell_of(p: Vector2) -> Vector2i:
	return Vector2i(clampi(int(p.x / CELL), 0, cols - 1), clampi(int(p.y / CELL), 0, rows - 1))


func clamp_inside(p: Vector2) -> Vector2:
	return p.clamp(Vector2(CELL, CELL), size - Vector2(CELL, CELL))


func is_wall(p: Vector2) -> bool:
	if p.x < 0 or p.y < 0 or p.x > size.x or p.y > size.y:
		return true
	for r in walls:
		if r.has_point(p):
			return true
	for i in polys.size():
		if poly_boxes[i].has_point(p) and Geometry2D.is_point_in_polygon(p, polys[i]):
			return true
	return false


## Brush id at `p` (1-based index into `brushes`), 0 outside any brush.
func brush_at(p: Vector2) -> int:
	if brushes.is_empty():
		return 0
	var x := int(p.x / SIGHT_CELL)
	var y := int(p.y / SIGHT_CELL)
	if x < 0 or y < 0 or x >= sight_cols or y >= sight_rows:
		return 0
	var v := sight[y * sight_cols + x]
	return v if v != SIGHT_WALL else 0


## Line of sight on the sight grid (walls block it; brush doesn't - it only hides what's inside).
func sight_clear(a: Vector2, b: Vector2) -> bool:
	var steps := int(a.distance_to(b) / SIGHT_CELL) + 1
	var inv := 1.0 / SIGHT_CELL
	for k in range(1, steps):
		var q := a.lerp(b, float(k) / steps)
		var x := int(q.x * inv)
		var y := int(q.y * inv)
		if x < 0 or y < 0 or x >= sight_cols or y >= sight_rows or sight[y * sight_cols + x] == SIGHT_WALL:
			return false
	return true


func has_los(a: Vector2, b: Vector2) -> bool:
	var steps := int(a.distance_to(b) / (CELL * 0.5)) + 1
	for k in range(1, steps + 1):
		if astar.is_point_solid(cell_of(a.lerp(b, float(k) / steps))):
			return false
	return true


func _nearest_open_cell(c: Vector2i) -> Vector2i:
	if not astar.is_point_solid(c):
		return c
	for r in range(1, 30):
		var best := Vector2i(-1, -1)
		var bd := INF
		for x in range(c.x - r, c.x + r + 1):
			for y in range(c.y - r, c.y + r + 1):
				if absi(x - c.x) != r and absi(y - c.y) != r:
					continue
				var id := Vector2i(x, y)
				if x < 0 or y < 0 or x >= cols or y >= rows or astar.is_point_solid(id):
					continue
				var dd := Vector2(id - c).length_squared()
				if dd < bd:
					bd = dd
					best = id
		if best.x >= 0:
			return best
	return c


## Closest walkable position (used for teleports, summons and click targets).
func nearest_open(p: Vector2) -> Vector2:
	p = clamp_inside(p)
	var c := cell_of(p)
	if not astar.is_point_solid(c):
		return p
	return astar.get_point_position(_nearest_open_cell(c))


func find_path(from: Vector2, to: Vector2) -> PackedVector2Array:
	to = nearest_open(to)
	if has_los(from, to):
		return PackedVector2Array([to])
	var fc := _nearest_open_cell(cell_of(from))
	var tc := cell_of(to)
	var pts := astar.get_point_path(fc, tc, true)
	if pts.is_empty():
		return PackedVector2Array([to])
	pts[pts.size() - 1] = to
	var out := PackedVector2Array()
	var cur := from
	var i := 0
	while i < pts.size():
		var j := pts.size() - 1
		while j > i and not has_los(cur, pts[j]):
			j -= 1
		out.append(pts[j])
		cur = pts[j]
		i = j + 1
	return out
