{
  "name": "Youmuu's Ghostblade",
  "cost": 3100,
  "rarity": "mythic",
  "from": [
    "serrated_dirk",
    "caulfields_warhammer"
  ],
  "tags": [
    "Damage",
    "Active",
    "NonbootsMovement",
    "ArmorPenetration",
    "AbilityHaste"
  ],
  "display": "counter('youmuus_ghostblade_shards')",
  "stats": {
    "attack_damage": 60.0,
    "lethality": "18 + (7 + max(0.0, min(level, 18.0) - 7.0)) * int(counter('youmuus_ghostblade_shards') >= 100)",
    "ability_haste": 15.0,
    "move_speed": "0.4 * counter('youmuus_ghostblade_shards') * (1 - in_combat)"
  },
  "mythic_stats": {
    "attack_damage": 7
  },
  "description": "",
  "passives": [
    {
      "name": "Haunt",
      "description": "While walking you gain 1 Spectral Shard per 55 units moved (up to 100). Out of champion combat each shard gives 0.4 move speed (40 at 100). At 100 shards you also gain 7-18 lethality (by level). Shards reset 3s after you damage an enemy champion.",
      "on": "interval",
      "interval": 0.25,
      "if": "moving and counter('youmuus_ghostblade_shards') < 100",
      "effects": [
        {
          "type": "counter",
          "id": "youmuus_ghostblade_shards",
          "add": "ms * 0.25 / 55.0",
          "max": 100
        }
      ]
    },
    {
      "name": "Haunt",
      "on": "deal_damage",
      "if": "t_champion and not t_self and not has('youmuus_ghostblade_fade')",
      "effects": [
        {
          "type": "mark",
          "target": "self",
          "id": "youmuus_ghostblade_fade",
          "duration": 3
        },
        {
          "type": "delay",
          "time": 3,
          "effects": [
            {
              "type": "counter",
              "id": "youmuus_ghostblade_shards",
              "set": 0
            }
          ]
        }
      ]
    }
  ],
  "active": {
    "name": "Wraith Step",
    "description": "Gain 25% move speed for 6s (units never block each other here, so the ghosting part is built in).",
    "cooldown": 45,
    "targeting": "self",
    "effects": [
      {
        "type": "buff",
        "target": "self",
        "id": "youmuus_ghostblade_wraith",
        "duration": 6,
        "add": {
          "move_speed_bonus": 0.25
        }
      }
    ]
  }
}
