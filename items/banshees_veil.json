{
  "name": "Banshee's Veil",
  "cost": 2600,
  "rarity": "legendary",
  "from": [
    "fiendish_codex",
    "verdant_barrier"
  ],
  "tags": [
    "SpellBlock",
    "SpellDamage",
    "CooldownReduction",
    "AbilityHaste"
  ],
  "stats": {
    "ability_power": 80.0,
    "magic_resist": 45.0,
    "ability_haste": 10.0
  },
  "description": "",
  "passives": [
    {
      "name": "Annul",
      "description": "A spell shield blocks the next enemy ability. After it breaks it comes back in 40s; taking damage from champions during that time restarts the 40s.",
      "on": "interval",
      "interval": 0.5,
      "if": "not has('spellshield') and time >= counter('banshees_veil_ready')",
      "effects": [
        {
          "type": "spellshield",
          "target": "self"
        }
      ]
    },
    {
      "name": "Annul",
      "on": "spellshield_pop",
      "effects": [
        {
          "type": "counter",
          "id": "banshees_veil_ready",
          "set": "time + 40"
        }
      ]
    },
    {
      "name": "Annul",
      "on": "take_damage",
      "if": "t_champion and not t_self and time < counter('banshees_veil_ready')",
      "effects": [
        {
          "type": "counter",
          "id": "banshees_veil_ready",
          "set": "time + 40"
        }
      ]
    }
  ]
}
