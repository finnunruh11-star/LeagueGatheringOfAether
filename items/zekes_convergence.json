                "on": "deal_damage",
                "if": "t_has('zekes_convergence_target') and (is_attack or (is_ability and not is_dot))",
                "effects": [
                  {
                    "type": "damage",
                    "damage_type": "magic",
                    "amount": "30 + 40 * (min(level, 18) - 1) / 17.0 + 0.015 * max_hp + 0.075 * ap",
                    "vfx": "streaks",
                    "color": "#8fd3ff"
                  }
                ]
              }
            ]
          },
          {
            "type": "vfx",
            "kind": "line",
            "from": "caster",
            "to": "target",
            "color": "#8fd3ff"
          }
        ]
