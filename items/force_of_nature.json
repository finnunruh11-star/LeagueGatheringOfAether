{
  "name": "Force of Nature",
  "cost": 2800,
  "rarity": "legendary",
  "from": [
    "negatron_cloak",
    "ruby_crystal",
    "winged_moonplate"
  ],
  "tags": [
    "Health",
    "SpellBlock",
    "NonbootsMovement"
  ],
  "stats": {
    "max_hp": 400.0,
    "magic_resist": 60.0,
    "move_speed_bonus": 0.05
  },
  "description": "",
  "passives": [
    {
      "name": "Absorb",
      "description": "Taking magic damage from an enemy champion grants a Steadfast stack for 7s (max 10; each enemy adds at most one per second). Being stunned, rooted, knocked back or pulled by an enemy champion grants 2 more.",
      "on": "take_damage",
      "if": "dtype == 'magic' and t_champion and not t_self and not t_has('force_of_nature_icd')",
      "effects": [
        {
          "type": "mark",
          "id": "force_of_nature_icd",
          "duration": 1
        },
        {
          "type": "mark",
          "target": "self",
          "id": "force_of_nature_steadfast",
          "duration": 7,
          "max_stacks": 10
        },
        {
          "type": "buff",
          "target": "self",
          "id": "force_of_nature_dissipate",
          "duration": 7,
          "if": "stacks('force_of_nature_steadfast') >= 10",
          "add": {
            "magic_resist": 30,
            "move_speed_bonus": 0.1
          }
        }
      ]
    },
    {
      "name": "Absorb",
      "on": "cc_received",
      "if": "(cc == 'stun' or cc == 'root' or cc == 'knockback' or cc == 'pull') and not t_has('force_of_nature_cc_icd')",
      "effects": [
        {
          "type": "mark",
          "id": "force_of_nature_cc_icd",
          "duration": 1
        },
        {
          "type": "mark",
          "target": "self",
          "id": "force_of_nature_steadfast",
          "duration": 7,
          "max_stacks": 10,
          "stacks": 2
        },
        {
          "type": "buff",
          "target": "self",
          "id": "force_of_nature_dissipate",
          "duration": 7,
          "if": "stacks('force_of_nature_steadfast') >= 10",
          "add": {
            "magic_resist": 30,
            "move_speed_bonus": 0.1
          }
        }
      ]
    },
    {
      "name": "Dissipate",
      "description": "While at 10 Steadfast stacks, gain 30 magic resist and 10% move speed."
    }
  ]
}
