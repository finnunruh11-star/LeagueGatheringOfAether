  "passives": [
    {
      "name": "Fortify",
      "description": "Taking damage from an enemy champion grants +5% bonus armor and bonus magic resist for 6s, stacking up to 5 times (one stack per champion).",
      "on": "take_damage",
      "if": "t_champion and not t_self",
      "effects": [
        {
