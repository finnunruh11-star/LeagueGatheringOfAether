          "target": "self",
          "id": "gargoyle_stoneplate_fortify",
          "duration": 6,
          "max_stacks": 5,
          "stacks": "1 - int(t_has('gargoyle_stoneplate_source'))",
          "add": {
            "armor": "0.05 * bonus_armor / (1 + 0.05 * stacks('gargoyle_stoneplate_fortify'))",
            "magic_resist": "0.05 * bonus_mr / (1 + 0.05 * stacks('gargoyle_stoneplate_fortify'))"
          }
        },
        {
          "type": "mark",
          "id": "gargoyle_stoneplate_source",
          "duration": 6
        }
      ]
    }
  ],
  "active": {
    "name": "Unbreakable",
    "description": "Gain a 100 (+90% bonus health) shield that decays over 2.5s and grow 25% larger for 2.5s.",
    "cooldown": 90,
    "targeting": "self",
    "effects": [
      {
        "type": "shield",
        "target": "self",
        "amount": "100 + 0.9 * bonus_hp",
        "duration": 2.5,
        "decay": true
      },
      {
        "type": "buff",
        "target": "self",
        "id": "gargoyle_stoneplate_size",
