{
  "name": "Heartsteel",
  "cost": 3200,
  "rarity": "mythic",
  "from": [
    "giants_belt",
    "kindlegem",
    "crystalline_bracer"
  ],
  "tags": [
    "Health",
    "HealthRegen",
    "CooldownReduction",
    "AbilityHaste"
  ],
  "display": "counter('heartsteel_hp')",
  "stats": {
    "max_hp": "800 + counter('heartsteel_hp')",
    "hp_regen_percent": 2.0,
    "ability_haste": 20.0
  },
  "stats_mult": {
    "max_hp": "1 + 0.01 * legendaries"
  },
  "mythic_stats": {
    "size": 0.06
  },
  "description": "",
  "passives": [
    {
      "name": "Colossal Consumption",
      "description": "Staying within 700 of an enemy champion for 3s charges it up (the charge fades 5s after you leave). Your next attack on a charged champion deals 125 + 6% max health bonus physical damage and permanently adds 10% of that amount to this item's 800 health. 30s cooldown per champion.",
      "on": "interval",
      "interval": 0.5,
      "if": "near_enemies(700, 'heartsteel_cd') > 0",
      "effects": [
        {
          "type": "area",
          "at": "self",
          "radius": 700,
          "filter": "champions",
          "show": false,
          "effects": [
            {
              "type": "vfx",
              "kind": "ring",
              "at": "target",
              "radius": 60,
              "color": "#ff5c5c",
              "if": "t_stacks('heartsteel_charge') == 5 and not t_has('heartsteel_cd')"
            },
            {
              "type": "mark",
              "id": "heartsteel_charge",
              "duration": 5,
              "max_stacks": 6,
              "if": "not t_has('heartsteel_cd')"
            }
          ]
        }
      ]
    },
    {
      "name": "Colossal Consumption",
      "on": "attack",
      "if": "t_champion and t_stacks('heartsteel_charge') >= 6 and not t_has('heartsteel_cd')",
      "effects": [
        {
          "type": "damage",
          "damage_type": "physical",
          "amount": "125 + 0.06 * max_hp",
          "vfx": "burst",
          "color": "#ff4a4a"
        },
        {
          "type": "counter",
          "id": "heartsteel_hp",
          "add": "0.1 * (125 + 0.06 * max_hp)"
        },
        {
          "type": "remove",
          "id": "heartsteel_charge"
        },
        {
          "type": "mark",
          "id": "heartsteel_cd",
          "duration": 30
        }
      ]
    },
    {
      "name": "Mythic Passive",
      "description": "Each other legendary item also raises your max health by 1% (and your size by 6%)."
    }
  ]
}
