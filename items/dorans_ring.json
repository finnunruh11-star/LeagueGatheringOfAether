        {
          "type": "heal",
          "target": "self",
          "amount": "0.45 * (1 + 0.5 * int(has('dorans_ring_drain')))",
          "if": "max_mana == 0"
        }
      ]
    },
    {
      "name": "Drain",
      "on": "deal_damage",
      "if": "t_champion",
      "effects": [
        {
          "type": "mark",
          "target": "self",
          "id": "dorans_ring_drain",
          "duration": 10,
          "max_stacks": 1
        }
      ]
    }
  ]
