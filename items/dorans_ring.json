        }
      ]
    },
    {
      "name": "Drain",
      "description": "Restore 1 mana per second, or 1.5 for 10s after you damage an enemy champion. Champions without mana regain 45% of that as health instead.",
      "on": "interval",
      "interval": 1,
      "effects": [
        {
          "type": "mana",
