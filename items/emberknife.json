{
  "name": "Emberknife",
  "cost": 350,
  "rarity": "jungle",
  "tags": [
    "LifeSteal",
    "SpellVamp",
    "Jungle"
  ],
  "group": "jungle",
  "display": "counter('emberknife_smites')",
  "stats": {},
  "description": "No jungle in this game: monster effects work on minions and Smite is this item's active. Huntsman (bonus XP) and consuming the item after 5 Smites are left out.",
  "passives": [
    {
      "name": "Sear",
      "description": "Damaging a minion with an attack or ability burns it for 60 (+30% AP, +5% bonus AD, +2% bonus health) magic damage over 5s.",
      "on": "deal_damage",
      "if": "t_minion and (is_attack or is_ability)",
      "effects": [
        {
          "type": "dot",
          "id": "emberknife_sear",
          "amount": "(60 + 0.3 * ap + 0.05 * bonus_ad + 0.02 * bonus_hp) / 5",
          "duration": 5,
          "interval": 1,
          "damage_type": "magic",
          "color": "#ff8a3d"
        }
      ]
    },
    {
      "name": "Scavenger",
      "description": "Heal for 7% of the damage you deal to minions.",
      "on": "deal_damage",
      "if": "t_minion",
      "effects": [
        {
          "type": "heal",
          "target": "self",
          "amount": "0.07 * dmg"
        }
      ]
    },
    {
      "name": "Recoup",
      "description": "Away from enemies (no enemy unit within 1000 range, standing in for the jungle), restore 8-18 (by level) mana per second.",
      "on": "interval",
      "interval": 1,
      "if": "near_units(1000) == 0",
      "effects": [
        {
          "type": "mana",
          "target": "self",
          "amount": "8 + 0.6 * (min(level, 18) - 1)"
        }
      ]
    },
    {
      "name": "Challenging Smite",
      "description": "Champions hit by Challenging Smite are marked for 4s: your attacks and abilities burn them for 48-125 (by level) true damage over 2.5s, and they deal 20% less damage to you.",
      "on": "deal_damage",
      "if": "(is_attack or is_ability) and t_has('emberknife_challenged')",
      "effects": [
        {
          "type": "dot",
          "id": "emberknife_burn",
          "amount": "(48 + 77 * (min(level, 18) - 1) / 17) / 2.5",
          "duration": 2.5,
          "interval": 0.5,
          "damage_type": "true",
          "color": "#ff5a1f"
        }
      ]
    },
    {
      "name": "Challenging Smite",
      "on": "take_damage_pre",
      "if": "t_has('emberknife_challenged')",
      "effects": [
        {
          "type": "modify_damage",
          "mult": 0.8
        }
      ]
    }
  ],
  "active": {
    "name": "Smite",
    "description": "Deal 450 true damage to an enemy minion or summon. After 5 Smites (counted on the slot) it becomes Challenging Smite: 900 damage, and it can also mark an enemy champion for 4s.",
    "cooldown": 45,
    "targeting": "unit",
    "range": 500,
    "effects": [
      {
        "type": "damage",
        "damage_type": "true",
        "amount": "450 + 450 * int(counter('emberknife_smites') >= 5)",
        "vfx": "fire",
        "color": "#ff7a2f",
        "if": "not t_champion"
      },
      {
        "type": "text",
        "text": "Challenging Smite!",
        "at": "self",
        "color": "#ff7a2f",
        "size": 22,
        "if": "not t_champion and counter('emberknife_smites') == 4"
      },
      {
        "type": "counter",
        "id": "emberknife_smites",
        "add": 1,
        "max": 5,
        "if": "not t_champion"
      },
      {
        "type": "item_cooldown",
        "item": "emberknife",
        "reset": true,
        "if": "t_champion and counter('emberknife_smites') < 5"
      },
      {
        "type": "text",
        "text": "Smite 5 times first",
        "at": "self",
        "color": "#dddddd",
        "size": 18,
        "if": "t_champion and counter('emberknife_smites') < 5"
      },
      {
        "type": "mark",
        "id": "emberknife_challenged",
        "duration": 4,
        "max_stacks": 1,
        "if": "t_champion and counter('emberknife_smites') >= 5"
      },
      {
        "type": "vfx",
        "kind": "blast",
        "at": "target",
        "radius": 90,
        "vfx": "fire",
        "color": "#ff7a2f",
        "if": "t_champion and counter('emberknife_smites') >= 5"
      }
    ]
  }
}
