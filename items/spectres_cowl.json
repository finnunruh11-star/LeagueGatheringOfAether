        {
          "type": "buff",
          "target": "self",
          "id": "spectres_cowl_regen",
          "duration": "min(10, 0.333 * dmg)",
          "add": {
            "hp_regen_percent": 1.5
          }
        }
      ]
    }
  ]
}
