{
  "name": "Spectre's Cowl",
  "cost": 1250,
  "rarity": "epic",
  "from": [
    "ruby_crystal",
    "null_magic_mantle"
  ],
  "tags": [
    "Health",
    "HealthRegen",
    "SpellBlock"
  ],
  "stats": {
    "max_hp": 250.0,
    "magic_resist": 25.0
  },
  "description": "",
  "passives": [
    {
      "name": "Incorporeal",
      "description": "Champion damage boosts your base health regen by 150% for 1s per 3 damage taken (max 10s).",
      "on": "take_damage",
      "if": "t_champion and not t_self and (dmg >= 30 or not has('spectres_cowl_regen'))",
