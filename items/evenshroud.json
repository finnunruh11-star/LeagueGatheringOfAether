                  "effects": [
                    {
                      "type": "modify_damage",
                      "mult": 1.07
                    }
                  ]
                }
              ]
            },
            {
              "type": "vfx",
              "kind": "ring",
              "at": "target",
              "radius": 55,
              "color": "#ffd98a"
            }
          ]
        }
      ]
    },
    {
