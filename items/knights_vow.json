{
  "name": "Knight's Vow",
  "cost": 2200,
  "rarity": "legendary",
  "from": [
    "lifewell_pendant",
    "crystalline_bracer"
  ],
  "tags": [
    "Health",
    "HealthRegen",
    "Armor",
    "Aura",
    "Active",
    "CooldownReduction",
    "AbilityHaste"
  ],
  "stats": {
    "max_hp": 350.0,
    "armor": 25.0,
    "ability_haste": 15.0,
    "hp_regen_percent": 1.25
  },
  "description": "",
  "passives": [
    {
      "name": "Sacrifice",
      "description": "While your Worthy ally is within 1250 range, 10% of the damage they take is redirected to you (20% while they are below 30% health), and you heal for 10% of the damage they deal to champions. Redirection stops while you are below 30% health."
    }
  ],
  "active": {
    "name": "Pledge",
    "description": "Choose an allied champion within 1250 range as your Worthy ally until you pick another one; the bond lasts through deaths, and a champion can be bound by only one Knight's Vow. Used on yourself, it picks the nearest allied champion (no cooldown if there is none).",
    "cooldown": 60,
    "targeting": "ally",
    "range": 1250,
    "requires": "t_champion and (not t_self or near_allies(1250) > 0)",
    "effects": [
      {
        "type": "counter",
        "id": "knights_vow_pledge",
        "add": 1
      },
      {
        "type": "area",
        "at": "self",
        "radius": 30000,
        "affects": "allies",
        "show": false,
        "effects": [
          {
            "type": "remove",
            "id": "knights_vow_worthy"
          }
        ]
      },
      {
        "type": "area",
        "at": "target",
        "radius": "10 + 1240 * int(t_self)",
        "affects": "allies",
        "filter": "champions",
        "exclude_self": true,
        "sort": "nearest",
        "max_targets": 1,
        "show": false,
        "effects": [
          {
            "type": "remove",
            "id": "knights_vow_worthy",
            "any_source": true
          },
          {
            "type": "mark",
            "id": "knights_vow_worthy",
            "duration": 99999,
            "persist": true,
            "stacks": "counter('knights_vow_pledge')",
            "max_stacks": 100000,
            "triggers": [
              {
                "on": "take_damage_pre",
                "if": "not ally and has_item('knights_vow') and h_dist() <= 1250 and hp >= 0.3 * max_hp",
                "effects": [
                  {
                    "type": "modify_damage",
                    "mult": "0.8 if h_hp() < 0.3 * h_stat('max_hp') else 0.9"
                  },
                  {
                    "type": "damage",
                    "target": "self",
                    "damage_type": "true",
                    "amount": "(0.2 if h_hp() < 0.3 * h_stat('max_hp') else 0.1) * dmg",
                    "raw": true,
                    "vfx": "none"
                  }
                ]
              },
              {
                "on": "deal_damage",
                "if": "t_champion and not ally and has_item('knights_vow') and h_dist() <= 1250",
                "effects": [
                  {
                    "type": "heal",
                    "target": "self",
                    "amount": "0.1 * dmg"
                  }
                ]
              },
              {
                "on": "spawn",
                "if": "t_stacks('knights_vow_worthy') != counter('knights_vow_pledge')",
                "effects": [
                  {
                    "type": "remove",
                    "id": "knights_vow_worthy",
                    "target": "holder"
                  }
                ]
              }
            ]
          },
          {
            "type": "vfx",
            "kind": "line",
            "from": "caster",
            "to": "target",
            "color": "#9fd0ff"
          }
        ]
      }
    ]
  }
}
