          "persist": true
        },
        {
          "type": "passive_cooldown",
          "passive": 0,
          "amount": 40
        }
      ]
    },
    {
      "name": "Annul",
      "on": "take_damage",
      "if": "t_champion and not t_self and has('edge_of_night_cd')",
