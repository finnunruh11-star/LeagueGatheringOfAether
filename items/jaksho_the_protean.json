          "type": "buff",
          "target": "self",
          "id": "jaksho_the_protean_empowered",
          "duration": 9999,
          "add": {
            "armor": "0.2 * bonus_armor",
            "magic_resist": "0.2 * bonus_mr"
          },
          "if": "in_combat and stacks('jaksho_the_protean_resilience') >= 8 and not has('jaksho_the_protean_empowered')"
        },
        {
