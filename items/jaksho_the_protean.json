              "amount": "80 + 0.07 * bonus_hp",
              "vfx": "magic",
              "color": "#b77cff"
            },
            {
              "type": "heal",
              "target": "self",
              "amount": "80 + 0.07 * bonus_hp",
              "if": "t_champion"
            }
          ]
        },
        {
          "type": "vfx",
          "kind": "ring",
          "at": "self",
          "radius": 90,
          "color": "#b77cff",
