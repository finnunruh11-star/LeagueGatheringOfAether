{
  "name": "Rod of Ages",
  "cost": 2800,
  "rarity": "legendary",
  "from": [
    "blasting_wand",
    "catalyst_of_aeons",
    "amplifying_tome"
  ],
  "tags": [
    "Health",
    "HealthRegen",
    "SpellDamage",
    "Mana",
    "ManaRegen",
    "CooldownReduction",
    "AbilityHaste"
  ],
  "group": "eternity",
  "display": "counter('rod_of_ages_stacks')",
  "stats": {
    "ability_power": "60 + 4 * counter('rod_of_ages_stacks')",
    "max_hp": "400 + 20 * counter('rod_of_ages_stacks')",
    "max_mana": "400 + 20 * counter('rod_of_ages_stacks')"
  },
  "description": "",
  "passives": [
    {
      "name": "Timeless",
      "description": "Every 60s this item gains 20 health, 20 mana and 4 ability power, up to 10 times (+200 health, +200 mana, +40 AP). At 10 stacks you gain a level and Eternity becomes 50% stronger.",
      "on": "interval",
      "interval": 1,
      "if": "counter('rod_of_ages_stacks') < 10",
      "effects": [
        {
          "type": "counter",
          "id": "rod_of_ages_since",
          "set": "time",
          "if": "counter('rod_of_ages_since') <= 0"
        },
        {
          "type": "counter",
          "id": "rod_of_ages_stacks",
          "add": "floor((time - counter('rod_of_ages_since')) / 60.0)",
          "max": 10,
          "if": "time - counter('rod_of_ages_since') >= 60"
        },
        {
          "type": "counter",
          "id": "rod_of_ages_since",
          "add": "60 * floor((time - counter('rod_of_ages_since')) / 60.0)",
          "if": "time - counter('rod_of_ages_since') >= 60"
        },
        {
          "type": "level_up",
          "target": "self",
          "if": "counter('rod_of_ages_stacks') >= 10"
        },
        {
          "type": "text",
          "text": "Rod of Ages fully grown!",
          "at": "self",
          "color": "#c8a0ff",
          "size": 22,
          "if": "counter('rod_of_ages_stacks') >= 10"
        }
      ]
    },
    {
      "name": "Eternity",
      "description": "Taking damage from champions restores mana equal to 7% of the damage before resistances. Casting an ability heals you for 25% of the mana it cost, up to 20 health per cast.",
      "on": "take_damage",
      "if": "t_champion and not t_self and max_mana > 0",
      "effects": [
        {
          "type": "mana",
          "target": "self",
          "amount": "0.07 * dmg_raw * (1.5 if counter('rod_of_ages_stacks') >= 10 else 1.0)"
        }
      ]
    },
    {
      "name": "Eternity",
      "on": "cast",
      "if": "amount > 0 and max_mana > 0",
      "effects": [
        {
          "type": "heal",
          "target": "self",
          "amount": "min(20, 0.25 * amount) * (1.5 if counter('rod_of_ages_stacks') >= 10 else 1.0)"
        }
      ]
    }
  ]
}
