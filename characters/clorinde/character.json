      "cast_w@vigil": {"sheet": "sprites/cast_w_vigil.webp", "frame_width": 306, "frame_height": 266, "frames": 24, "fps": 20, "anchor": [160.0, 156.2]},
      "cast_r@vigil": {"sheet": "sprites/cast_r_vigil.webp", "frame_width": 248, "frame_height": 249, "frames": 24, "fps": 20, "anchor": [133.0, 156.2]},
      "hurt@vigil": {"sheet": "sprites/hurt_vigil.webp", "frame_width": 149, "frame_height": 181, "frames": 8, "fps": 20, "anchor": [81.0, 123.2]},
