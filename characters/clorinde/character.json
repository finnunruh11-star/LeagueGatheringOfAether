      "cast_e": {"sheet": "sprites/cast_e.webp", "frame_width": 165, "frame_height": 191, "frames": 14, "fps": 20, "anchor": [88.0, 127.2]},
      "cast_e_recast": {"sheet": "sprites/cast_e_recast.webp", "frame_width": 305, "frame_height": 262, "frames": 14, "fps": 20, "anchor": [160.0, 152.2], "hit": 2, "land": 6},
      "cast_r": {"sheet": "sprites/cast_r.webp", "frame_width": 248, "frame_height": 249, "frames": 24, "fps": 20, "anchor": [133.0, 156.2]},
