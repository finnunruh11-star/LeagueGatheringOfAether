{
  "name": "Clorinde",
  "title": "Champion Duelist",
  "description": "Sword in one hand, pistol in the other. Night Vigil turns her attacks into pistol shots that build Bond of Life, and her lunge cashes it in for damage and healing. Sword, Q and W scale with AD; pistol and R with AP; the lunge with whichever is higher.",
  "color": "#6f5bd6",
  "stats": {
    "max_hp": 620,
    "hp_regen": 1.6,
    "move_speed": 340,
    "attack_damage": 62,
    "attack_speed": 0.7,
    "attack_range": 125,
    "armor": 28,
    "magic_resist": 30
  },
  "per_level": {"max_hp": 96, "attack_damage": 3.4, "armor": 3.0, "magic_resist": 1.3},
  "attack": {"ranged": false, "projectile_color": "#c9a2ff"},
  "passive": {
    "name": "Lawful Remuneration",
    "description": "Bond of Life (the crimson bar on her health bar): healing pays it off before it restores any health. Healing bonuses apply first, so they also pay it off faster. During Night Vigil, healing from anything except Impale the Night is turned into Bond of Life instead. Whenever her Bond of Life is fully paid off, she gains 15% attack speed for 6s (stacks 2 times).",
    "triggers": [
      {"on": "bond_cleared", "effects": [
        {"type": "buff", "target": "self", "id": "lawful_remuneration", "duration": 6, "max_stacks": 2, "add": {"bonus_attack_speed": 0.15}},
        {"type": "vfx", "kind": "ring", "at": "self", "radius": 70, "color": "#ff6f9a"}
      ]}
    ]
  },
  "abilities": {
    "q": {
      "name": "Suppressing Shots",
      "description": "A blinding flash in a cone in front of her stuns enemies for 0.6s, then a fan of pistol shots hits the same cone for 60/95/130/165/200 (+70% AD) physical damage.",
      "cooldown": [13, 12, 11, 10, 9],
      "targeting": "direction",
      "range": 380,
      "effects": [
        {"type": "area", "at": "self", "radius": 380, "angle": 70, "color": "#fff3c4", "vfx": "star", "effects": [
          {"type": "stun", "duration": 0.6}
        ]},
        {"type": "delay", "time": 0.15, "effects": [
          {"type": "projectile", "count": 5, "spread": 60, "speed": 2600, "range": 380, "radius": 5, "color": "#d9c2ff", "pierce": true},
          {"type": "area", "at": "self", "radius": 380, "angle": 70, "color": "#b48cff", "show": false, "effects": [
            {"type": "damage", "amount": "[60, 95, 130, 165, 200][rank - 1] + 0.7 * ad", "damage_type": "physical", "vfx": "streaks"}
          ]}
        ]}
      ]
    },
    "w": {
      "name": "Riposte",
      "description": "Clorinde parries for 0.75s: she can't move, but takes no damage and ignores stuns, roots, slows and silences. Then she thrusts in the chosen direction for 70/110/150/190/230 (+80% AD) physical damage, slowing by 50% for 1.5s. If she parried an enemy champion's attack, ability or crowd control (damage over time doesn't count), the thrust stuns for 1s instead.",
      "cooldown": [18, 16.5, 15, 13.5, 12],
      "targeting": "direction",
      "range": 450,
      "effects": [
        {"type": "invulnerable", "target": "self", "duration": 0.75},
        {"type": "buff", "target": "self", "id": "riposte_stance", "duration": 0.75, "multiply": {"move_speed": 0}, "triggers": [
          {"on": "blocked", "if": "t_champion and not is_dot", "cooldown": 0.4, "effects": [
            {"type": "mark", "target": "self", "id": "riposte_parried", "duration": 1.5, "max_stacks": 1},
            {"type": "text", "text": "Parried!", "at": "self", "color": "#fff3c4", "size": 22}
          ]}
        ]},
        {"type": "text", "text": "En garde", "at": "self", "color": "#e8dcff", "size": 20},
        {"type": "delay", "time": 0.75, "effects": [
          {"type": "beam", "length": 450, "width": 80, "color": "#e8dcff", "vfx": "slash", "effects": [
            {"type": "damage", "amount": "[70, 110, 150, 190, 230][rank - 1] + 0.8 * ad", "damage_type": "physical", "vfx": "slash"},
            {"type": "stun", "duration": 1, "if": "has('riposte_parried')"},
            {"type": "slow", "amount": 0.5, "duration": 1.5, "if": "not has('riposte_parried')"}
          ]},
          {"type": "remove", "target": "self", "id": "riposte_parried"}
        ]}
      ]
    },
    "e": {
      "name": "Hunter's Vigil",
      "description": "Night Vigil for 7s: her attacks become pistol shots (425 range, +40/50/60/70/80% attack speed) dealing 25/35/45/55/65 (+15% AP) magic damage. A shot gives her Bond of Life equal to 35% of her max HP while she has less than 100%. Shots fired while she has Bond of Life deal 50% more damage and pierce enemies behind the target. Recast: Impale the Night. The cooldown starts when Night Vigil ends.",
      "cooldown": [16, 15, 14, 13, 12],
      "targeting": "self",
      "effects": [
        {"type": "buff", "target": "self", "id": "night_vigil", "duration": 7,
          "add": {"attack_range": 300, "bonus_attack_speed": "[0.4, 0.5, 0.6, 0.7, 0.8][rank - 1]", "heal_to_bond": 1},
          "attack": {
            "ranged": true, "projectile_speed": 1800, "projectile_color": "#c9a2ff", "projectile_size": 5, "hit_vfx": "streaks",
            "damage": "([25, 35, 45, 55, 65][rank - 1] + 0.15 * ap) * (1.5 if bond > 0 else 1.0)",
            "damage_type": "magic",
            "pierce": "bond > 0", "pierce_range": 350,
            "on_hit": [
              {"type": "bond_of_life", "target": "self", "amount": "0.35 * max_hp", "if": "bond < max_hp"}
            ]
          }},
        {"type": "text", "text": "Night Vigil", "at": "self", "color": "#c9a2ff", "size": 24}
      ],
      "recast": {
        "name": "Impale the Night",
        "description": "Lunge toward the cursor, damaging every enemy you pass through. The lunge depends on her Bond of Life: none = a short lunge (300) for 60% damage; under 100% = 75% damage; 100% or more = Pact, three strikes of 75%. Base damage is 40/60/80/100/120 + 50% AD or + 30% AP (whichever is higher, as physical or magic damage). Then she heals for 110% of her Bond of Life, which pays it off. Usable every 1s during Night Vigil.",
        "status": "night_vigil",
        "charges": 0,
        "cooldown": 1,
        "targeting": "direction",
        "range": 400,
        "effects": [
          {"type": "counter", "id": "lunge_tier", "set": "0 if bond <= 0 else (2 if bond >= max_hp else 1)"},
          {"type": "dash", "to": "direction", "distance": "300 if bond <= 0 else 400", "speed": 1700, "on_hit": [
            {"type": "damage", "if": "counter('lunge_tier') == 0", "vfx": "claw",
              "amount": "0.6 * ([40, 60, 80, 100, 120][rank - 1] + max(0.5 * ad, 0.3 * ap))",
              "damage_type": "'physical' if 0.5 * ad >= 0.3 * ap else 'magic'"},
            {"type": "damage", "if": "counter('lunge_tier') == 1", "vfx": "slash",
              "amount": "0.75 * ([40, 60, 80, 100, 120][rank - 1] + max(0.5 * ad, 0.3 * ap))",
              "damage_type": "'physical' if 0.5 * ad >= 0.3 * ap else 'magic'"},
            {"type": "repeat", "if": "counter('lunge_tier') == 2", "count": 3, "interval": 0.12, "effects": [
              {"type": "damage", "vfx": "slash", "color": "#ff6f9a",
                "amount": "0.75 * ([40, 60, 80, 100, 120][rank - 1] + max(0.5 * ad, 0.3 * ap))",
                "damage_type": "'physical' if 0.5 * ad >= 0.3 * ap else 'magic'"}
            ]}
          ], "on_end": [
            {"type": "text", "text": "Pact!", "at": "self", "color": "#ff6f9a", "size": 24, "if": "counter('lunge_tier') == 2"}
          ]},
          {"type": "heal", "target": "self", "amount": "1.1 * bond", "convert": false, "if": "bond > 0"},
          {"type": "bond_of_life", "target": "self", "set": 0}
        ]
      }
    },
    "r": {
      "name": "Last Lightfall",
      "description": "Clorinde gains Bond of Life equal to 66% of her max HP, then unloads saber and pistol: 8 volleys over 2s hit every enemy within 450 of her for 30/45/60 (+10% AP) magic damage each. She can move, attack and lunge meanwhile.",
      "cooldown": [90, 75, 60],
      "targeting": "self",
      "effects": [
        {"type": "bond_of_life", "target": "self", "amount": "0.66 * max_hp"},
        {"type": "text", "text": "Last Lightfall", "at": "self", "color": "#c9a2ff", "size": 30},
        {"type": "repeat", "count": 8, "interval": 0.25, "effects": [
          {"type": "area", "at": "self", "radius": 450, "color": "#b48cff", "show": false, "effects": [
            {"type": "damage", "amount": "[30, 45, 60][rank - 1] + 0.1 * ap", "damage_type": "magic", "vfx": "streaks"}
          ]},
          {"type": "vfx", "kind": "ring", "at": "self", "radius": 450, "color": "#b48cff"},
          {"type": "projectile", "count": "6 + fmod(i, 3)", "spread": 360, "speed": 2400, "range": 450, "radius": 4, "color": "#d9c2ff", "pierce": true}
        ]}
      ]
    }
  }
}
